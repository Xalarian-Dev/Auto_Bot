# Copy this file to .env and fill in your keys
# cp .env.example .env

# Anthropic API key — used by the Claude scorer
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# SerpAPI key — used for Google Jobs (LinkedIn, Indeed, Glassdoor, etc.)
# Free tier: monthly limit to check on serpapi.com. Paid from $50/mo for 5,000 searches.
# Get yours at: https://serpapi.com/
SERPAPI_KEY=your_serpapi_key_here

# USAJobs API — free, register at https://developer.usajobs.gov/
# Required for Mode B (North America) USAJobs source
USAJOBS_KEY=your_usajobs_api_key_here
USAJOBS_EMAIL=your_email@example.com

# Path to the SQLite database (relative to project root)
DB_PATH=data/scout.db

# Path to the search criteria config
CONFIG_PATH=config/criteria.yaml
